# Copie este ficheiro para "api/.env" e preencha os valores.
#   cp .env.example .env   (ou copie manualmente no Windows)

# --- Base de dados (PostgreSQL) ---
# Formato: postgresql://UTILIZADOR:PALAVRA_PASSE@HOST:PORTA/NOME_DA_BD?schema=public
# Exemplo com PostgreSQL nativo na porta 5432:
DATABASE_URL="postgresql://mobiliario:mobiliario123@localhost:5432/mobiliario?schema=public"

# --- Servidor ---
PORT=8080
NODE_ENV=development
DEBUG_ERRORS=1

# --- Autenticacao ---
# Use um segredo forte com pelo menos 12 caracteres.
JWT_SECRET=troque-por-um-segredo-forte

# --- CORS (origens do frontend permitidas) ---
FRONT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Integracoes externas (opcionais em desenvolvimento; deixe vazio) ---
# Pagamentos e2payments (M-Pesa / eMola)
E2_BASE=https://e2payments.explicador.co.mz
E2_CLIENT_ID=
E2_CLIENT_SECRET=
# Cloudinary (proxy de imagens)
CLOUDINARY_CLOUD=
